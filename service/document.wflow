				</dict>
				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>HELPER="$HOME/Applications/Create Markdown.app/Contents/MacOS/CreateMarkdown"
dest=""
for item in "$@"; do
  if [ -d "$item" ]; then
    dest="$item"
    break
  elif [ -e "$item" ]; then
    dest="$(dirname "$item")"
    break
  fi
done
if [ -z "$dest" ]; then
  dest=$(/usr/bin/osascript -e 'tell application "Finder" to POSIX path of (target of front Finder window as alias)' 2&gt;/dev/null || true)
fi
if [ -n "$dest" ]; then
  "$HELPER" --create "$dest"
fi
</string>
					<key>CheckedForUserDefaultShell</key>
					<true/>
					<key>inputMethod</key>
					<integer>1</integer>
					<key>shell</key>
					<string>/bin/zsh</string>
					<key>source</key>
					<string></string>
				</dict>
